{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pascual-labs-website",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-27",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/health"]
  },
  "routes": [
    {
      "pattern": "pascual-labs.com",
      "custom_domain": true
    },
    {
      "pattern": "www.pascual-labs.com",
      "custom_domain": true
    }
  ],
  "env": {
    "staging": {
      "name": "pascual-labs-website-staging",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        {
          "pattern": "dev.pascual-labs.com",
          "custom_domain": true
        }
      ]
    }
  }
}
